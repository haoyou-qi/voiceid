{
  "name": "g2-voiceid",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "sim": "evenhub-simulator http://localhost:5173",
    "pack": "npm run build && evenhub pack app.json dist -o voiceid.ehpk",
    "test": "tsx test/synth.test.ts",
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "latest",
    "onnxruntime-web": "1.17.3"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "latest",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
